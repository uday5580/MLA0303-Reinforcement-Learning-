import random

class CustomEnv:
    def __init__(self):
        self.num_states = 10
        self.actions = ["left", "right"]
        self.max_steps = 100

    def reset(self):
        self.current_state = 0
        self.steps = 0
        return self.current_state

    def step(self, action):
        self.steps += 1

        if action == "right":
            self.current_state = min(self.current_state + 1, 9)
        else:
            self.current_state = max(self.current_state - 1, 0)

        reward = 1 if self.current_state == 9 else 0
        done = self.current_state == 9 or self.steps >= self.max_steps

        return self.current_state, reward, done, {}


def monte_carlo_control(env, episodes=1000, gamma=1.0):
    returns_sum = {}
    returns_count = {}
    Q = {}
    policy = {}

    for episode in range(episodes):
        episode_data = []

        state = env.reset()
        done = False

        # Generate episode
        while not done:
            if random.random() < 0.1:
                action = random.choice(env.actions)
            else:
                actions = [a for a in env.actions if (state, a) in Q]

                if actions:
                    action = max(actions, key=lambda a: Q[(state, a)])
                else:
                    action = random.choice(env.actions)

            next_state, reward, done, _ = env.step(action)

            episode_data.append((state, action, reward))
            state = next_state

        # First-visit Monte Carlo update
        G = 0
        visited = set()

        for state, action, reward in reversed(episode_data):
            G = gamma * G + reward

            if (state, action) not in visited:
                visited.add((state, action))

                key = (state, action)

                returns_sum[key] = returns_sum.get(key, 0) + G
                returns_count[key] = returns_count.get(key, 0) + 1

                Q[key] = returns_sum[key] / returns_count[key]

    # Generate policy
    for state in range(env.num_states):
        values = {}

        for action in env.actions:
            if (state, action) in Q:
                values[action] = Q[(state, action)]

        if values:
            policy[state] = max(values, key=values.get)
        else:
            policy[state] = random.choice(env.actions)

    return Q, policy


env = CustomEnv()

Q, optimal_policy = monte_carlo_control(env)

print("Learned Optimal Policy:")

for state, action in optimal_policy.items():
    print("State:", state, "Action:", action)
