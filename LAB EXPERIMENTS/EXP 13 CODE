import numpy as np

n_articles = 10
n_states = 5

Q = np.zeros((n_states, n_articles))

np.random.seed(42)

rewards = np.random.rand(n_states, n_articles)

alpha = 0.1
gamma = 0.9
epsilon = 0.1

num_episodes = 1000

for episode in range(num_episodes):

    state = np.random.randint(n_states)

    for step in range(20):

        # Epsilon-greedy action selection
        if np.random.rand() < epsilon:
            action = np.random.randint(n_articles)
        else:
            action = np.argmax(Q[state])

        reward = rewards[state, action]

        next_state = np.random.randint(n_states)

        # TD(0) update
        target = reward + gamma * np.max(Q[next_state])

        Q[state, action] += alpha * (
            target - Q[state, action]
        )

        state = next_state


optimal_policy = np.argmax(Q, axis=1)

print("Optimal News Recommendation Policy:")

for state in range(n_states):
    print(
        "User State", state,
        "-> Article", optimal_policy[state]
    )

print("\nMaximum Q-values:")

print(np.max(Q, axis=1))
