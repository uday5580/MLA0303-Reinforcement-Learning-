import gymnasium as gym
import gymnasium as gym
import numpy as np

# Create Environment
env = gym.make("CartPole-v1")

# Reset Environment
state, info = env.reset()

print("Reinforcement Learning Demonstration\n")

total_reward = 0
done = False
step = 1

while not done:

    # Agent selects a random action
    action = env.action_space.sample()

    # Environment response
    next_state, reward, terminated, truncated, info = env.step(action)

    done = terminated or truncated

    # Reward / Punishment
    if done:
        reward = -1      # Punishment
    else:
        reward = 1       # Reward

    total_reward += reward

    print(f"Step {step}")
    print("State :", state)
    print("Action:", action)
    print("Reward:", reward)
    print("----------------------")

    state = next_state
    step += 1

print("Total Reward:", total_reward)

env.close()
