import numpy as np
import random

num_states = 21
num_actions = 4

initial_state = 0
destination_state = 20

Q = np.zeros(
    (num_states, num_actions)
)


def take_action(state, action):

    if action == 0:
        next_state = max(0, state - 1)

    elif action == 1:
        next_state = min(num_states - 1, state + 1)

    elif action == 2:
        next_state = max(0, state - 5)

    else:
        next_state = min(num_states - 1, state + 5)

    if next_state == destination_state:
        reward = 100
    else:
        reward = -1

    return next_state, reward


alpha = 0.1
gamma = 0.9
epsilon = 0.1

episodes = 1000

for episode in range(episodes):

    state = initial_state

    for step in range(100):

        if random.random() < epsilon:
            action = random.randint(0, 3)
        else:
            action = np.argmax(Q[state])

        next_state, reward = take_action(
            state,
            action
        )

        Q[state, action] += alpha * (
            reward
            + gamma * np.max(Q[next_state])
            - Q[state, action]
        )

        state = next_state

        if state == destination_state:
            break


# Find optimal path
state = initial_state

optimal_path = [state]

for step in range(100):

    if state == destination_state:
        break

    action = np.argmax(Q[state])

    next_state, reward = take_action(
        state,
        action
    )

    if next_state == state:
        break

    state = next_state

    optimal_path.append(state)


print("Optimal Path:")
print(optimal_path)

print("\nNumber of Steps:",
      len(optimal_path) - 1)
