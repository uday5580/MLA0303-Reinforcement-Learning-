import numpy as np

n_states = 3
n_actions = 2

P = np.zeros((n_states, n_actions, n_states))

P[0, 0, 0] = 0.7
P[0, 0, 1] = 0.3

P[0, 1, 1] = 0.5
P[0, 1, 2] = 0.5

P[1, 0, 0] = 0.4
P[1, 0, 1] = 0.6

P[1, 1, 0] = 0.1
P[1, 1, 1] = 0.9

P[2, 0, 2] = 1.0
P[2, 1, 2] = 1.0

R = np.zeros((n_states, n_actions, n_states))

R[0, 0, 0] = 1.0
R[0, 0, 1] = 2.0

R[0, 1, 1] = 3.0
R[0, 1, 2] = 4.0

R[1, 0, 0] = 0.0
R[1, 0, 1] = 2.0

R[1, 1, 0] = 1.0
R[1, 1, 1] = 3.0


def value_iteration(P, R, gamma=0.9, epsilon=1e-6):

    n_states, n_actions, _ = P.shape

    V = np.zeros(n_states)

    iterations = 0

    while True:
        V_new = np.zeros(n_states)

        for s in range(n_states):

            Q_values = []

            for a in range(n_actions):

                value = 0

                for next_state in range(n_states):
                    value += P[s, a, next_state] * (
                        R[s, a, next_state]
                        + gamma * V[next_state]
                    )

                Q_values.append(value)

            V_new[s] = max(Q_values)

        iterations += 1

        if np.max(np.abs(V_new - V)) < epsilon:
            break

        V = V_new

    return V_new, iterations


optimal_values, iterations = value_iteration(P, R)

print("Optimal Values:")
print(optimal_values)

print("Number of Iterations:", iterations)
