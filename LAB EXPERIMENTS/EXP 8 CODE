import numpy as np
import random

# 6 x 4 Reward Matrix
grid = np.array([
    [0, 0, 1, 2],
    [2, 1, 3, 4],
    [1, 2, 4, 5],
    [3, 1, 5, 6],
    [4, 3, 6, 8],
    [5, 6, 8, 10]
])

rows, cols = grid.shape

# Start Position
position = (0, 0)

print("6 x 4 Reward Matrix\n")
print(grid)

print("\nExploration Steps:\n")

total_reward = 0

for step in range(10):

    i, j = position

    # Possible Moves
    moves = []

    if i > 0:
        moves.append((i-1, j))
    if i < rows-1:
        moves.append((i+1, j))
    if j > 0:
        moves.append((i, j-1))
    if j < cols-1:
        moves.append((i, j+1))

    # Exploration: Random Move
    position = random.choice(moves)

    reward = grid[position]
    total_reward += reward

    print(f"Step {step+1}")
    print("Position :", position)
    print("Reward   :", reward)
    print("---------------------")

print("Total Reward =", total_reward)
