import numpy as np

# 3 x 4 Grid
rows, cols = 3, 4

# Reward Matrix
reward = np.zeros((rows, cols))

# Fire and Goal
reward[0][3] = -1      # (1,4)
reward[1][3] = 1       # (2,4)

gamma = 0.9

# Value Function
V = np.zeros((rows, cols))

# Goal Value
V[1][3] = 1

# Bellman Update
for _ in range(10):
    newV = V.copy()

    for i in range(rows):
        for j in range(cols):

            if (i, j) == (1, 3):
                continue

            neighbors = []

            if i > 0:
                neighbors.append(V[i-1][j])
            if i < rows-1:
                neighbors.append(V[i+1][j])
            if j > 0:
                neighbors.append(V[i][j-1])
            if j < cols-1:
                neighbors.append(V[i][j+1])

            newV[i][j] = reward[i][j] + gamma * max(neighbors)

    V = newV

print("Value Function\n")
print(np.round(V,2))

# Best Path
print("\nBest Path:")

state = (0,0)

while state != (1,3):

    print(state, end=" -> ")

    i, j = state
    moves = []

    if i > 0:
        moves.append(((i-1,j),V[i-1][j]))
    if i < rows-1:
        moves.append(((i+1,j),V[i+1][j]))
    if j > 0:
        moves.append(((i,j-1),V[i][j-1]))
    if j < cols-1:
        moves.append(((i,j+1),V[i][j+1]))

    state = max(moves,key=lambda x:x[1])[0]

print("Goal (+1)")
