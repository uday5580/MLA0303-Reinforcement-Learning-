import random

class TicTacToe:

    def __init__(self):
        self.wins = [
            (0, 1, 2),
            (3, 4, 5),
            (6, 7, 8),
            (0, 3, 6),
            (1, 4, 7),
            (2, 5, 8),
            (0, 4, 8),
            (2, 4, 6)
        ]

        self.reset()

    def reset(self):
        self.board = [" "] * 9
        self.current_player = "X"

    def available_moves(self):
        return [
            i for i in range(9)
            if self.board[i] == " "
        ]

    def make_move(self, action):

        if action in self.available_moves():
            self.board[action] = self.current_player

            self.current_player = (
                "O" if self.current_player == "X"
                else "X"
            )

    def winner(self):

        for a, b, c in self.wins:

            if (
                self.board[a] != " "
                and self.board[a] == self.board[b]
                and self.board[b] == self.board[c]
            ):
                return self.board[a]

        return None

    def game_over(self):

        return (
            self.winner() is not None
            or not self.available_moves()
        )


Q = {}

alpha = 0.1
gamma = 0.9
epsilon = 0.1


def choose_action(env, state):

    moves = env.available_moves()

    if random.random() < epsilon:
        return random.choice(moves)

    return max(
        moves,
        key=lambda a: Q.get(
            (state, a), 0
        )
    )


episodes = 10000

env = TicTacToe()

for episode in range(episodes):

    env.reset()

    while not env.game_over():

        state = tuple(env.board)

        action = choose_action(
            env, state
        )

        env.make_move(action)

        next_state = tuple(env.board)

        winner = env.winner()

        if winner == "X":
            reward = 1
        elif winner == "O":
            reward = -1
        else:
            reward = 0

        old_q = Q.get(
            (state, action), 0
        )

        next_values = [
            Q.get((next_state, a), 0)
            for a in env.available_moves()
        ]

        max_next = (
            max(next_values)
            if next_values else 0
        )

        Q[(state, action)] = (
            old_q
            + alpha
            * (
                reward
                + gamma * max_next
                - old_q
            )
        )


print("Training completed.")

print(
    "Learned State-Action Pairs:",
    len(Q)
)
