import numpy as np

# 6 x 4 Reward Matrix
grid = np.array([
    [0, 0, 1, 2],
    [2, 1, 3, 4],
    [1, 2, 4, 5],
    [3, 1, 5, 6],
    [4, 3, 6, 8],
    [5, 6, 8, 10]
])

rows, cols = grid.shape

# Start Position
position = (0, 0)

print("6 x 4 Reward Matrix\n")
print(grid)

print("\nExploitation Steps:\n")

total_reward = 0

while position != (5, 3):

    i, j = position

    moves = []

    # Down
    if i < rows - 1:
        moves.append((i + 1, j))

    # Right
    if j < cols - 1:
        moves.append((i, j + 1))

    # Up
    if i > 0:
        moves.append((i - 1, j))

    # Left
    if j > 0:
        moves.append((i, j - 1))

    # Choose the neighbor with the maximum reward
    best_move = max(moves, key=lambda x: grid[x])

    position = best_move
    reward = grid[position]
    total_reward += reward

    print("Position:", position, " Reward:", reward)

print("\nGoal Reached!")
print("Total Reward =", total_reward)
